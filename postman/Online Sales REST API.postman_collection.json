    {
      "name": "Skenario 3 - Memeriksa User Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get('customer_token');\r",
              "\r",
              "if (!token) {\r",
              "    throw new Error('Customer token tidak ditemukan!');\r",
              "}\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: 'Authorization',\r",
              "    value: 'Bearer ' + token\r",
              "});\r",
              "\r",
              "console.log('Authorization header berhasil disiapkan.');\r",
              "console.log('Token tersedia:', !!token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer 9|KrqGaWBvQ41pAzYg6tcq3DUlQhJ18ZcESMrLfC8382b27982",
            "type": "text"
          }
        ],
